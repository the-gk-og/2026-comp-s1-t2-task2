# Server Configuration
PORT=3000
FLASK_ENV=development

# Database Configuration
# Set DB_TYPE to 'postgres' for PostgreSQL or 'csv' for CSV file-based storage
DB_TYPE=csv
CSV_FILE_PATH=./data/registrations.csv

# PostgreSQL Configuration (only needed if DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rsvp_db
DB_USER=postgres
DB_PASSWORD=your_password

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Email Configuration (SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@event.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Admin Panel Configuration
ADMIN_SECRET_KEY=your_super_secret_key_change_this
JWT_SECRET=your_jwt_secret_key_change_this

# Google Wallet Configuration
GOOGLE_WALLET_ISSUER_ID=your_issuer_id
GOOGLE_WALLET_CLASS_ID=your_class_id

# Application URLs
FRONTEND_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:3000/webhook/stripe
